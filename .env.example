# Copy to .env to override defaults used by docker compose.
# Your IANA timezone (controls daily rollover & medication due times)
TZ=Asia/Kolkata
WEB_PORT=8080
API_PORT=8000
LOG_LEVEL=INFO
# Comma-separated list of allowed browser origins for direct API calls (the web app uses a same-origin proxy).
CORS_ORIGINS=*
# Seed sample activity for the "default_user" id.
WELLORA_SEED_DEMO=false
